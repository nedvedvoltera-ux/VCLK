WEB_PORT=8080
WEB_HTTPS_PORT=8443
TLS_IP=192.168.215.44
PUBLIC_HOSTNAME=vclk.asntl.ru
# Папка с TLS-сертификатом (монтируется в контейнер web).
# Положите сюда fullchain.pem + privkey.pem (или server.crt + server.key).
# Если файлов нет — будет сгенерирован self-signed сертификат.
TLS_CERT_DIR=./certs
RECORDINGS_HOST_PATH=./recordings
LIVEKIT_CONFIG_FILE=./livekit.prod.yaml

# Transcription (faster-whisper on CPU) + summary via network Qwen
TRANSCRIPTION_ENABLED=true
REDIS_URL=redis://redis:6379/0
ASR_QUEUE_KEY=transcription:jobs
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
SUMMARY_ENABLED=true
SUMMARY_API_BASE_URL=http://192.168.215.74:9080/v1
SUMMARY_API_KEY=
SUMMARY_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
SUMMARY_TIMEOUT_SEC=180
SUMMARY_MAX_TOKENS=512
SUMMARY_TEMPERATURE=0.0
